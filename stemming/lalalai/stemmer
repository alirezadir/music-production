#!/bin/bash

# Stemmer - A bash wrapper for lalalai_splitter.py
# Usage: ./stemmer <input_file_or_directory> [-o output_directory] [-s stems]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Function to show usage
show_usage() {
    echo "Usage: $0 <input_file_or_directory> [-o output_directory] [-s stems]"
    echo ""
    echo "Arguments:"
    echo "  input_file_or_directory    Path to a single audio file or directory containing audio files"
    echo "  -o output_directory        Optional: Specify output directory (default: input_directory/stems)"
    echo "  -s stems                  Optional: Specify stems to extract (comma-separated, default: all)"
    echo ""
    echo "Available stems: vocals, drum, piano, bass, electric_guitar, acoustic_guitar, synthesizer, strings, wind"
    echo ""
    echo "Examples:"
    echo "  $0 song.mp3"
    echo "  $0 song.mp3 -s vocals,drum,bass"
    echo "  $0 song.mp3 -o /path/to/output -s vocals"
    echo "  $0 /path/to/audio/files -s piano,strings"
    echo ""
    echo "Note: Make sure LALALAI_LICENSE environment variable is set or .env file exists"
}

# Check if Python script exists
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="$SCRIPT_DIR/lalalai_splitter.py"

if [[ ! -f "$PYTHON_SCRIPT" ]]; then
    print_error "lalalai_splitter.py not found in $SCRIPT_DIR"
    exit 1
fi

# Check if Python 3 is available
if ! command -v python3 &> /dev/null; then
    print_error "python3 is not installed or not in PATH"
    exit 1
fi

# Check if required packages are installed
python3 -c "import tqdm" 2>/dev/null || {
    print_warning "tqdm package not found. Installing..."
    pip3 install tqdm
}

# Parse arguments
INPUT_PATH=""
OUTPUT_DIR=""
STEMS=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -o|--output)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        -s|--stems)
            STEMS="$2"
            shift 2
            ;;
        -h|--help)
            show_usage
            exit 0
            ;;
        -*)
            print_error "Unknown option $1"
            show_usage
            exit 1
            ;;
        *)
            if [[ -z "$INPUT_PATH" ]]; then
                INPUT_PATH="$1"
            else
                print_error "Multiple input paths specified"
                show_usage
                exit 1
            fi
            shift
            ;;
    esac
done

# Check if input path is provided
if [[ -z "$INPUT_PATH" ]]; then
    print_error "No input file or directory specified"
    show_usage
    exit 1
fi

# Check if input path exists
if [[ ! -e "$INPUT_PATH" ]]; then
    print_error "Input path does not exist: $INPUT_PATH"
    exit 1
fi

# Build the command
CMD="python3 \"$PYTHON_SCRIPT\" --input \"$INPUT_PATH\""

if [[ -n "$OUTPUT_DIR" ]]; then
    CMD="$CMD --output \"$OUTPUT_DIR\""
fi

if [[ -n "$STEMS" ]]; then
    CMD="$CMD --stem \"$STEMS\""
fi

print_info "Running: $CMD"
print_info "Input: $INPUT_PATH"
if [[ -n "$OUTPUT_DIR" ]]; then
    print_info "Output: $OUTPUT_DIR"
else
    print_info "Output: (default - input_directory/stems)"
fi
if [[ -n "$STEMS" ]]; then
    print_info "Stems: $STEMS"
else
    print_info "Stems: all (default)"
fi

# Run the Python script
eval $CMD

if [[ $? -eq 0 ]]; then
    print_success "Stemming completed successfully!"
else
    print_error "Stemming failed with exit code $?"
    exit 1
fi 